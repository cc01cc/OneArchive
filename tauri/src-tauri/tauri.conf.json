{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "one-archive",
  "version": "0.1.0",
  "identifier": "com.cc01cc.onearchive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:52105",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  
  "app": {
    "windows": [
      {
        "title": "one-archive",
        "width": 1000,
        "height": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws:; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
